# ── Site ──────────────────────────────────────────────────────────────────
# Canonical URL, used for metadataBase, Article schema.org, and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 1 wiring, Phase 4 likes/comments) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used for moderation/admin writes,
# and by the ingestion pipeline to look up game_follows/push_subscriptions.
SUPABASE_SERVICE_ROLE_KEY=

# ── Ingestion pipeline (Phase 5, used by the GitHub Actions cron) ──────────
# Set ANY of these four — used to summarize + categorize + score each
# article. Every one that's set gets tried, in this priority order, per
# article: OpenRouter -> Anthropic -> Gemini -> Groq — if a configured
# provider's call fails outright (bad key, no credits, etc.), the next
# configured one is tried automatically, not just at startup. See
# getConfiguredProviders in scripts/ingest/summarize.ts.
#
# OpenRouter (openrouter.ai) — one key, many models. Defaults to routing
# through Anthropic's Claude Haiku 4.5; override with OPENROUTER_MODEL
# (see openrouter.ai/models) to use a cheaper/free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Anthropic API directly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Google Gemini — free key at aistudio.google.com/apikey. Also used by the
# standalone pipeline below (same key, shared).
GEMINI_API_KEY=
GEMINI_MODEL=
# Groq — free key at console.groq.com/keys. Also used by the standalone
# pipeline below (same key, shared).
GROQ_API_KEY=
GROQ_MODEL=
# Shared secret the ingestion workflow sends to trigger on-demand ISR
# revalidation after new cards are published.
REVALIDATE_SECRET=

# ── Standalone AI-first pipeline (scripts/fetch-updates.mjs) ────────────────
# A separate experimental pipeline from the ingestion above, reusing the
# same GEMINI_API_KEY/GROQ_API_KEY set above — Gemini primary, Groq
# fallback, rule-based (keyword classification + word-count summarization)
# as the last resort when both AI calls fail. Neither key is required to
# run it (the rule-based path works with none set), but without either the
# whole run is rule-based only.
#
# Optional manual override to force a single path for isolated testing —
# one of: gemini, groq, rule-based. Unset uses the automatic fallback chain.
AI_PROVIDER=

# ── Game info panels (RAWG, optional — /game/[slug] pages) ──────────────────
# Get a free key at rawg.io/apidocs. Without it, the game info panel is
# just skipped, no other feature depends on it.
RAWG_API_KEY=

# ── Deals ingestion (Phase 6) ───────────────────────────────────────────────
STEAM_API_KEY=
INSTANT_GAMING_AFFILIATE_ID=
ENEBA_AFFILIATE_ID=
AMAZON_ASSOCIATES_TAG=

# ── Distribution (Telegram/Discord push, same pattern as AI Signal Brief) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── Comments (Phase 4 — only needed if Giscus embed is chosen over custom) ─
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# ── Web push (game-follow notifications) ────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server/CI-only. Never expose to the client.
VAPID_PRIVATE_KEY=
# Contact URI required by the Web Push protocol, e.g. mailto:you@example.com
VAPID_SUBJECT=

# ── Analytics (search vs. direct vs. referral tracking) ────────────────────
# GA4 measurement ID (e.g. G-XXXXXXXXXX) from analytics.google.com. The
# gtag.js snippet (src/components/analytics/google-analytics.tsx) is
# skipped entirely when this is unset.
NEXT_PUBLIC_ANALYTICS_ID=
