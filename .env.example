# ── Site ──────────────────────────────────────────────────────────────────
# Canonical URL, used for metadataBase, Article schema.org, and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 1 wiring, Phase 4 likes/comments) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used for moderation/admin writes,
# and by the ingestion pipeline to look up game_follows/push_subscriptions.
SUPABASE_SERVICE_ROLE_KEY=

# ── Ingestion pipeline (Phase 5, used by the GitHub Actions cron) ──────────
# Summarization/classification/clustering runs against a local Ollama
# instance — no API key, no billing, no rate limit. The GitHub Actions
# workflow installs Ollama and starts it automatically (see ingest.yml). For
# local runs, install Ollama yourself (ollama.com) and make sure
# `ollama serve` is running before `pnpm ingest`.
#
# Rule-based keyword classification (scripts/ingest/rule-based.ts) is the
# fallback ONLY if Ollama itself fails to respond (not running, timed out,
# out of memory) — not a normal path.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434
# Shared secret the ingestion workflow sends to trigger on-demand ISR
# revalidation after new cards are published.
REVALIDATE_SECRET=

# ── Game info panels (RAWG, optional — /game/[slug] pages) ──────────────────
# Get a free key at rawg.io/apidocs. Without it, the game info panel is
# just skipped, no other feature depends on it.
RAWG_API_KEY=

# ── Deals ingestion (Phase 6) ───────────────────────────────────────────────
STEAM_API_KEY=
INSTANT_GAMING_AFFILIATE_ID=
ENEBA_AFFILIATE_ID=
AMAZON_ASSOCIATES_TAG=

# ── Distribution (Telegram/Discord push, same pattern as AI Signal Brief) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── Comments (Phase 4 — Giscus, GitHub Discussions-backed) ──────────────────
# Generate all four at giscus.app once the giscus GitHub App is installed
# on this repo and Discussions is enabled. NEXT_PUBLIC_GISCUS_REPO and
# NEXT_PUBLIC_GISCUS_CATEGORY_ID are also read by the ingestion pipeline
# (scripts/ingest/lib/comment-counts.ts) to sync real comment counts back
# into data/cards.json — see .github/workflows/ingest.yml.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# ── Web push (game-follow notifications) ────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server/CI-only. Never expose to the client.
VAPID_PRIVATE_KEY=
# Contact URI required by the Web Push protocol, e.g. mailto:you@example.com
VAPID_SUBJECT=

# ── Analytics (search vs. direct vs. referral tracking) ────────────────────
# GA4 measurement ID (e.g. G-XXXXXXXXXX) from analytics.google.com. The
# gtag.js snippet (src/components/analytics/google-analytics.tsx) is
# skipped entirely when this is unset.
NEXT_PUBLIC_ANALYTICS_ID=
